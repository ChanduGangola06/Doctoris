# Root .gitignore — applies to Admin/ and Landing/ (and any other app folder)
# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# testing
coverage/

# next.js
.next/
out/

# production
build/
dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env files / secrets — never commit real credentials
.env
.env*.local
.env.development
.env.production
*.env
!.env.example
secrets/
*.key
*.pfx
*.p12
credentials.json
service-account*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
Thumbs.db
